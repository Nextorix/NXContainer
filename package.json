{
  "name": "nxcontainer",
  "version": "0.1.0-alpha.2",
  "author": { "name": "MoyuZJ", "email": "moyuzj@nextorix.dev" },
  "license": "GPL-3.0-or-later",
  "copyright": "Copyright (C) 2026 Nextorix",
  "description": "面向 LLM 智能体的轻量原生沙箱依赖库；Windows 实验性支持，Linux 待验证",
  "type": "module",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" }
  },
  "files": ["src", "bin", "native", "scripts/build.mjs", "docs", "examples", "README.md", "SECURITY.md", "LICENSE", "licenses"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs all",
    "test": "node --test test/*.test.js",
    "test:native": "cd native && go test ./...",
    "test:package": "node scripts/test-package.mjs",
    "check:native": "cd native && go vet ./..."
  }
}
